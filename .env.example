# Copie ce fichier en ".env" et remplis les valeurs depuis Firebase Console
# (Paramètres du projet > Général > Tes applications > App web > SDK setup and configuration).
# Le préfixe EXPO_PUBLIC_ est obligatoire : c'est lui qui indique à Expo
# d'injecter la variable dans le bundle JS (voir https://docs.expo.dev/guides/environment-variables/).
# Ces valeurs ne sont PAS des secrets serveur (elles sont visibles dans le bundle client,
# comme pour toute app Firebase mobile/web) : la vraie protection des données vient des
# Firestore/Storage Security Rules (firestore.rules / storage.rules), pas de ce fichier.

EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
EXPO_PUBLIC_FIREBASE_MEASUREMENT_ID=
