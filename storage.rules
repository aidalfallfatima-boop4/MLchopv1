rules_version = '2';

// Security Rules Firebase Storage — miroir des chemins générés par
// services/firebase/storage.ts (productImagePath/profileImagePath/shopImagePath).
// Aucun écran actuel n'uploade encore d'image (produits/profils utilisent des
// emoji) : ces règles sont prêtes pour le jour où un sélecteur d'image est ajouté.
service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }

    function isImage() {
      return request.resource.contentType.matches('image/.*');
    }

    function isUnder5MB() {
      return request.resource.size < 5 * 1024 * 1024;
    }

    // products/{productId}/{fileName} — lecture publique (catalogue), écriture
    // laissée à tout compte connecté (le contrôle fin "c'est bien mon produit"
    // vit dans firestore.rules côté doc produit ; Storage ne connaît pas
    // l'auteur du produit sans upload d'un Cloud Function-vérifié token).
    match /products/{productId}/{fileName} {
      allow read: if true;
      allow write: if isSignedIn() && isImage() && isUnder5MB();
    }

    // profiles/{uid}/{fileName} — seul le propriétaire peut écrire sa propre photo.
    match /profiles/{uid}/{fileName} {
      allow read: if true;
      allow write: if isSignedIn() && request.auth.uid == uid && isImage() && isUnder5MB();
    }

    // shops/{sellerId}/{fileName} — seul le vendeur propriétaire peut écrire.
    match /shops/{sellerId}/{fileName} {
      allow read: if true;
      allow write: if isSignedIn() && request.auth.uid == sellerId && isImage() && isUnder5MB();
    }

    // Tout le reste : refusé par défaut.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
